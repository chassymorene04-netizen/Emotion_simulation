# Optional LLM connection. Never commit a real key.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_RUNTIME_ENABLED=true
LLM_AGENT_BATCH_SIZE=20
LLM_AGENT_CAP_PER_STEP=0
LLM_PERCEPTION_TEMPERATURE=0.10
LLM_TIMEOUT=120

# Published baseline configuration
EXPERIMENTAL_STIMULI_PATH=data/experimental_stimuli.json
NUM_AGENTS=300
NUM_STEPS=40
EXPERIMENT_RUNS_PER_SCENARIO=10
PARALLEL_WORKERS=50
SIM_RANDOM_SEED=42
GRAPH_EDGE_PROBABILITY=0.10
SEED_FRACTION=0.05
RECOMMENDATION_STRENGTH=0.40
REPEAT_STRENGTH=0.25
VISIBILITY_STRENGTH=0.35
MAX_CONTENT_AGE=5
MISINFORMATION_THRESHOLD=0.30
INITIAL_MISINFO_EXPOSURE_RATIO=0.05
INITIAL_EMOTION_RANGE=0.15,0.25
SENSITIVITY_RANGE=0.35,0.95
MEMORY_WINDOW_RANGE=5,8
EMOTION_DECAY=0.40
BETA_STIMULUS=0.18
GAMMA_FEEDBACK=0.20
MEMORY_EMOTION_WEIGHT=0.24
IGNORE_ACTION_WEIGHT=0.00
LIKE_ACTION_WEIGHT=0.40
REPLY_ACTION_WEIGHT=0.80
COMMENT_ACTION_WEIGHT=0.80
REPOST_ACTION_WEIGHT=1.00
HIGH_NEGATIVE_THRESHOLD=0.60

# Formal experiments are disabled by default in the submission package.
RUN_EXPERIMENT_1=false
RUN_EXPERIMENT_2=false
RUN_EXPERIMENT_3=false
RUN_EXPERIMENT_4=false
RUN_EXPERIMENT_5_AGENT_SCALE=false
MODEL_ROBUSTNESS_PROFILES=
